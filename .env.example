# OpsMemory Environment Configuration
# Leave MONGODB_URI blank for the local demo database, or set an Atlas URI.

# MongoDB Connection
MONGODB_URI=
MONGODB_DATABASE=opsmemory

# Server Configuration
PORT=5000

# Local Ollama models (no API key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=nemotron-3-nano:4b
EMBEDDING_MODEL=nomic-embed-text
