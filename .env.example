# OpsMemory Environment Configuration
# Copy this file to .env and fill in your connection details.

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=opsmemory

# Server Configuration
PORT=5000

# LLM & Embedding Configuration (for AI & Vector Search)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Embedding provider: gemini | openai | none
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
# Must match the embedding model output size:
#   gemini text-embedding-004        => 768
#   openai text-embedding-3-small    => 1536
EMBEDDING_DIMENSIONS=768
GEMINI_API_KEY=
OPENAI_API_KEY=

# Hybrid Search (Person 2)
TEXT_INDEX_NAME=idx_text_search_incident_memory
VECTOR_INDEX_NAME=vector_index_incidents
SEARCH_TOP_K=5
SEARCH_CANDIDATE_LIMIT=25
